    "Open Safari > Settings > Extensions and select Paramount Quality+.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Safari > Einstellungen > Erweiterungen und wähle Paramount Quality+."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Safari > Settings > Extensions and select Paramount Quality+."
          }
        },
        "es": {
