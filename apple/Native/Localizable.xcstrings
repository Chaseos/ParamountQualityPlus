{
  "sourceLanguage": "en",
  "strings": {
    "1. Enable Paramount Quality+ in Safari Settings > Extensions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Aktiviere Paramount Quality+ unter Safari > Einstellungen > Erweiterungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Enable Paramount Quality+ in Safari Settings > Extensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Activa Paramount Quality+ en Safari > Ajustes > Extensiones."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Activa Paramount Quality+ en Safari > Ajustes > Extensiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Activez Paramount Quality+ dans Safari > Réglages > Extensions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Attiva Paramount Quality+ in Safari > Impostazioni > Estensioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Safari 설정 > 확장 프로그램에서 Paramount Quality+를 활성화하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ative Paramount Quality+ em Safari > Ajustes > Extensões."
          }
        }
      }
    },
    "2. Allow the extension on paramountplus.com. This app cannot inspect your website permission settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Erlaube die Erweiterung auf paramountplus.com. Diese App kann deine Website-Berechtigungen nicht prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Allow the extension on paramountplus.com. This app cannot inspect your website permission settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Permite la extensión en paramountplus.com. Esta app no puede consultar los permisos de los sitios web."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Permite la extensión en paramountplus.com. Esta app no puede consultar los permisos de los sitios web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Autorisez l’extension sur paramountplus.com. Cette app ne peut pas vérifier les autorisations des sites web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Consenti l’estensione su paramountplus.com. Questa app non può verificare le autorizzazioni dei siti web."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2. paramountplus.com에서 확장 프로그램을 허용하세요. 이 앱은 웹사이트 권한 설정을 확인할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Permita a extensão em paramountplus.com. Este app não pode verificar as permissões dos sites."
          }
        }
      }
    },
    "3. Reload the Paramount+ page, start playback, then open the toolbar popup.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Lade die Paramount+-Seite neu, starte die Wiedergabe und öffne das Symbolleisten-Popup."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Reload the Paramount+ page, start playback, then open the toolbar popup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Recarga la página de Paramount+, inicia la reproducción y abre la ventana de la barra de herramientas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Recarga la página de Paramount+, inicia la reproducción y abre la ventana de la barra de herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Rechargez la page Paramount+, lancez la lecture, puis ouvrez la fenêtre de la barre d’outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Ricarica la pagina Paramount+, avvia la riproduzione e apri il popup nella barra degli strumenti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Paramount+ 페이지를 새로고침하고 재생을 시작한 다음 도구 막대 팝업을 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Recarregue a página do Paramount+, inicie a reprodução e abra o painel da barra de ferramentas."
          }
        }
      }
    },
    "A verified tip transaction finished. Thank you for your support.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine verifizierte Trinkgeldtransaktion wurde abgeschlossen. Danke für deine Unterstützung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A verified tip transaction finished. Thank you for your support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se completó una transacción de propina verificada. Gracias por tu apoyo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se completó una transacción de propina verificada. Gracias por tu apoyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une transaction de pourboire vérifiée est terminée. Merci de votre soutien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una transazione verificata è stata completata. Grazie per il supporto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인된 후원 거래가 완료되었습니다. 지원해 주셔서 감사합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma transação de gorjeta verificada foi concluída. Obrigado pelo apoio."
          }
        }
      }
    },
    "An approval was requested. Completed transactions shown above do not confirm that every pending request has resolved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Genehmigung wurde angefordert. Die oben abgeschlossenen Transaktionen bestätigen nicht, dass alle ausstehenden Anfragen erledigt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An approval was requested. Completed transactions shown above do not confirm that every pending request has resolved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solicitó una aprobación. Las transacciones completadas arriba no confirman que todas las solicitudes pendientes se hayan resuelto."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solicitó una aprobación. Las transacciones completadas arriba no confirman que todas las solicitudes pendientes se hayan resuelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une approbation a été demandée. Les transactions terminées ci-dessus ne confirment pas que toutes les demandes en attente sont résolues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stata richiesta un’approvazione. Le transazioni completate sopra non confermano che tutte le richieste in sospeso siano state risolte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인이 요청되었습니다. 위에 표시된 완료된 거래가 모든 대기 요청의 해결을 의미하지는 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma aprovação foi solicitada. As transações concluídas acima não confirmam que todas as solicitações pendentes foram resolvidas."
          }
        }
      }
    },
    "An incoming tip could not be verified. No tip was accepted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein eingehendes Trinkgeld konnte nicht verifiziert werden. Es wurde nicht angenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An incoming tip could not be verified. No tip was accepted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar una propina recibida. No se aceptó ninguna propina."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar una propina recibida. No se aceptó ninguna propina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pourboire reçu n’a pas pu être vérifié. Aucun pourboire n’a été accepté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare una mancia in arrivo. Nessuna mancia è stata accettata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신된 후원을 확인할 수 없습니다. 후원이 수락되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar uma gorjeta recebida. Nenhuma gorjeta foi aceita."
          }
        }
      }
    },
    "Done": {
      "extractionState": "manual",
