    "Purchases are unavailable on this Mac. Check App Store restrictions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe sind auf diesem Mac nicht verfügbar. Prüfe die App-Store-Beschränkungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases are unavailable on this Mac. Check App Store restrictions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras no están disponibles en este Mac. Revisa las restricciones del App Store."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras no están disponibles en este Mac. Revisa las restricciones del App Store."
