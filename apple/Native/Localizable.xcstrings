          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips are optional and support continued development. They unlock no features, content, status, or other benefits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las propinas son opcionales y apoyan el desarrollo. No desbloquean funciones, contenido, estatus ni otros beneficios."
