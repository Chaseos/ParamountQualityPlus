{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.25",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.paramountplus.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.paramountplus.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected/index.js",
        "injected/constants.js",
        "injected/config.js",
        "injected/diagnostics.js",
        "injected/manifest-parser.js",
        "injected/network-hooks.js",
        "injected/rewriter.js",
        "injected/state.js",
        "injected/stream-model.js",
        "injected/url-analysis.js",
        "injected/url-utils.js",
        "injected/prefetch.js"
      ],
      "matches": [
        "*://*.paramountplus.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@paramount-quality-plus",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
